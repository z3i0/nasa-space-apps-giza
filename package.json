{
  "name": "nasa-space-apps-giza",
  "version": "1.0.0",
  "private": true,
  "description": "NASA Space Apps Giza platform with Next.js, NestJS, and shadcn/ui",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "lint": "pnpm --filter web lint && pnpm --filter api lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json,css,md}\"",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:push": "pnpm --filter api prisma:push",
    "db:studio": "pnpm --filter api prisma:studio",
    "db:seed": "pnpm --filter api prisma:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "zod": "^4.6.5"
  }
}
