# Environment Variables for NestJS API
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/spaceapps_db?schema=public"

# Authentication & JWT Configuration
JWT_SECRET="replace-with-a-secure-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-secure-refresh-key"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Organizer Credentials (Seeding)
ORGANIZER_EMAIL="organizer@hackathon.local"
ORGANIZER_PASSWORD="ChangeMeInProduction123!"
ORGANIZER_NAME="Super Organizer"
