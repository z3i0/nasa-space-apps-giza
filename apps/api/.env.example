# Environment Variables for NestJS API
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ISO 8601 with timezone, e.g. 2026-10-25T18:00:00+02:00.
# Empty permits drafts but disables final submission. Set the actual event deadline.
SUBMISSION_DEADLINE=

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/spaceapps_db?schema=public"

# Authentication & JWT Configuration
JWT_SECRET="replace-with-a-secure-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-secure-refresh-key"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Organizer Credentials (Seeding)
ORGANIZER_EMAIL="organizer@hackathon.local"
ORGANIZER_PASSWORD="OrganizerSecure2026!"
ORGANIZER_NAME="Super Organizer"
