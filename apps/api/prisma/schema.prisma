generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Core Authentication & User Tables
// -------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String    @default("") @map("name")
  username      String?   @unique
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  avatar        String?
  role          String?   @default("participant")
  passwordHash  String?   @map("password_hash")
  phone         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  lastSeenAt    DateTime? @map("last_seen_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relationships
  sessions            Session[]
  accounts            Account[]
  roles               UserRole[]
  passwordResetTokens PasswordResetToken[]
  profile             Profile?
  createdTeams        Team[]               @relation("TeamCreator")
  teamMemberships     TeamMember[]         @relation("UserTeamMemberships")
  assignedTasks       TeamTask[]           @relation("AssignedTasks")
  receivedInvitations TeamInvitation[]     @relation("ReceivedInvitations")
  sentInvitations     TeamInvitation[]     @relation("SentInvitations")
  joinRequests        TeamJoinRequest[]    @relation("UserJoinRequests")

  @@index([email])
  @@index([deletedAt])
  @@index([isActive])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  impersonatedBy String?  @map("impersonated_by")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

enum TeamStatus {
  already_have_team
  want_to_join_team
  want_to_create_team
  working_individually
}

model Profile {
  id                 String     @id @default(uuid())
  userId             String     @unique @map("user_id")
  institution        String?    @map("institution")
  academicLevel      String?    @map("academic_level")
  skills             String[]   @default([])
  bio                String?
  interests          String[]   @default([])
  experience         String?
  preferredChallenge String?    @map("preferred_challenge")
  teamStatus         TeamStatus @default(want_to_join_team) @map("team_status")
  desiredRole        String?    @map("desired_role")
  githubUrl          String?    @map("github_url")
  linkedinUrl        String?    @map("linkedin_url")
  portfolioUrl       String?    @map("portfolio_url")
  isPublic           Boolean    @default(true) @map("is_public")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamStatus])
  @@index([preferredChallenge])
  @@index([isPublic])
  @@map("profiles")
}

// -------------------------------------------------------------
// Team Management Models
// -------------------------------------------------------------

enum TeamMemberRole {
  leader
  member
}

enum TeamSubmissionStatus {
  not_started
  draft
  submitted
}

enum TaskStatus {
  not_started
  in_progress
  completed
}

enum RequestStatus {
  pending
  accepted
  rejected
  canceled
}

model Team {
  id               String               @id @default(uuid())
  name             String               @unique
  description      String?
  challenge        String?              @map("challenge")
  track            String?              @map("track")
  createdById      String               @map("created_by_id")
  maxMembers       Int                  @default(5) @map("max_members")
  submissionStatus TeamSubmissionStatus @default(not_started) @map("submission_status")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  createdBy        User                 @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members          TeamMember[]
  tasks            TeamTask[]
  invitations      TeamInvitation[]
  joinRequests     TeamJoinRequest[]

  @@index([createdById])
  @@index([challenge])
  @@index([submissionStatus])
  @@map("teams")
}

model TeamMember {
  id           String         @id @default(uuid())
  teamId       String         @map("team_id")
  userId       String         @unique @map("user_id")
  role         TeamMemberRole @default(member) @map("role")
  assignedRole String?        @map("assigned_role")
  joinedAt     DateTime       @default(now()) @map("joined_at")

  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User           @relation("UserTeamMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamTask {
  id           String     @id @default(uuid())
  teamId       String     @map("team_id")
  title        String
  description  String?
  status       TaskStatus @default(not_started) @map("status")
  assignedToId String?    @map("assigned_to_id")
  dueDate      DateTime?  @map("due_date")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedTo   User?      @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([assignedToId])
  @@index([status])
  @@map("team_tasks")
}

model TeamInvitation {
  id              String        @id @default(uuid())
  teamId          String        @map("team_id")
  invitedUserId   String        @map("invited_user_id")
  invitedByUserId String        @map("invited_by_user_id")
  status          RequestStatus @default(pending) @map("status")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedUser     User          @relation("ReceivedInvitations", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedByUser   User          @relation("SentInvitations", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@unique([teamId, invitedUserId])
  @@index([invitedUserId])
  @@index([status])
  @@map("team_invitations")
}

model TeamJoinRequest {
  id        String        @id @default(uuid())
  teamId    String        @map("team_id")
  userId    String        @map("user_id")
  message   String?
  status    RequestStatus @default(pending) @map("status")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User          @relation("UserJoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([status])
  @@map("team_join_requests")
}


