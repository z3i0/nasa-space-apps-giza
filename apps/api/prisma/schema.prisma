generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Core Authentication & User Tables
// -------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String    @default("") @map("name")
  username      String?   @unique
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  avatar        String?
  role          String?   @default("participant")
  passwordHash  String?   @map("password_hash")
  phone         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  lastSeenAt    DateTime? @map("last_seen_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relationships
  sessions            Session[]
  accounts            Account[]
  roles               UserRole[]
  passwordResetTokens PasswordResetToken[]
  profile             Profile?
  createdTeams        Team[]               @relation("TeamCreator")
  teamMemberships     TeamMember[]         @relation("UserTeamMemberships")
  assignedTasks       TeamTask[]           @relation("AssignedTasks")
  receivedInvitations TeamInvitation[]     @relation("ReceivedInvitations")
  sentInvitations     TeamInvitation[]     @relation("SentInvitations")
  joinRequests        TeamJoinRequest[]    @relation("UserJoinRequests")
  mentorProfile       MentorProfile?
  mentorRequests      MentorshipRequest[] @relation("MentorRequests")
  sentMentorMessages  MentorshipMessage[]
  mentorSlots         MentorSlot[]
  favoriteChallenges  ChallengeFavorite[]
  createdChallenges   Challenge[] @relation("ChallengeCreator")
  judgingAssignments JudgingAssignment[]
  roleApplications RoleApplication[]

  @@index([email])
  @@index([deletedAt])
  @@index([isActive])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  impersonatedBy String?  @map("impersonated_by")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

enum TeamStatus {
  already_have_team
  want_to_join_team
  want_to_create_team
  working_individually
}

model Profile {
  id                 String     @id @default(uuid())
  userId             String     @unique @map("user_id")
  institution        String?    @map("institution")
  academicLevel      String?    @map("academic_level")
  skills             String[]   @default([])
  bio                String?
  interests          String[]   @default([])
  experience         String?
  preferredChallenge String?    @map("preferred_challenge")
  preferredChallengeId String? @map("preferred_challenge_id")
  preferredChallengeRef Challenge? @relation("ProfilePreferredChallenge", fields: [preferredChallengeId], references: [id], onDelete: SetNull)
  teamStatus         TeamStatus @default(want_to_join_team) @map("team_status")
  desiredRole        String?    @map("desired_role")
  githubUrl          String?    @map("github_url")
  linkedinUrl        String?    @map("linkedin_url")
  portfolioUrl       String?    @map("portfolio_url")
  isPublic           Boolean    @default(true) @map("is_public")
  shareProjectsWithMentors Boolean @default(true) @map("share_projects_with_mentors")
  hideFromSearch     Boolean    @default(false) @map("hide_from_search")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamStatus])
  @@index([preferredChallenge])
  @@index([preferredChallengeId])
  @@index([isPublic])
  @@index([isPublic, hideFromSearch, updatedAt(sort: Desc)], map: "profiles_matching_visibility_idx")
  @@map("profiles")
}

// -------------------------------------------------------------
// Team Management Models
// -------------------------------------------------------------

enum TeamMemberRole {
  leader
  member
}

enum TeamSubmissionStatus {
  not_started
  draft
  submitted
}

enum TaskStatus {
  not_started
  in_progress
  completed
}

enum RequestStatus {
  pending
  accepted
  rejected
  canceled
}

model Team {
  id               String               @id @default(uuid())
  name             String               @unique
  description      String?
  challenge        String?              @map("challenge")
  challengeId      String?              @map("challenge_id")
  selectedChallenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  track            String?              @map("track")
  createdById      String               @map("created_by_id")
  maxMembers       Int                  @default(5) @map("max_members")
  submissionStatus TeamSubmissionStatus @default(not_started) @map("submission_status")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  createdBy        User                 @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members          TeamMember[]
  tasks            TeamTask[]
  submission       TeamSubmission?
  invitations      TeamInvitation[]
  joinRequests     TeamJoinRequest[]
  mentorshipRequests MentorshipRequest[]
  bookedMentorSlots MentorSlot[]
  judgingAssignments JudgingAssignment[]

  @@index([createdById])
  @@index([challenge])
  @@index([challengeId])
  @@index([submissionStatus])
  @@map("teams")
}

model TeamSubmission {
  teamId       String @id @map("team_id")
  title        String @default("")
  summary      String @default("")
  challenge    String @default("")
  projectUrl   String @default("") @map("project_url")
  repositoryUrl String @default("") @map("repository_url")
  demoUrl      String @default("") @map("demo_url")
  status       TeamSubmissionStatus @default(draft)
  version      Int @default(1)
  submittedAt  DateTime? @map("submitted_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  team         Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_submissions")
}

model TeamMember {
  id           String         @id @default(uuid())
  teamId       String         @map("team_id")
  userId       String         @unique @map("user_id")
  role         TeamMemberRole @default(member) @map("role")
  assignedRole String?        @map("assigned_role")
  joinedAt     DateTime       @default(now()) @map("joined_at")

  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User           @relation("UserTeamMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamTask {
  id           String     @id @default(uuid())
  teamId       String     @map("team_id")
  title        String
  description  String?
  status       TaskStatus @default(not_started) @map("status")
  assignedToId String?    @map("assigned_to_id")
  dueDate      DateTime?  @map("due_date")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedTo   User?      @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([assignedToId])
  @@index([status])
  @@map("team_tasks")
}

model TeamInvitation {
  id              String        @id @default(uuid())
  teamId          String        @map("team_id")
  invitedUserId   String        @map("invited_user_id")
  invitedByUserId String        @map("invited_by_user_id")
  status          RequestStatus @default(pending) @map("status")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedUser     User          @relation("ReceivedInvitations", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedByUser   User          @relation("SentInvitations", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@unique([teamId, invitedUserId])
  @@index([invitedUserId])
  @@index([status])
  @@map("team_invitations")
}

model TeamJoinRequest {
  id        String        @id @default(uuid())
  teamId    String        @map("team_id")
  userId    String        @map("user_id")
  message   String?
  status    RequestStatus @default(pending) @map("status")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User          @relation("UserJoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([status])
  @@map("team_join_requests")
}

model MentorProfile {
  userId       String   @id @map("user_id")
  expertise    String[] @default([])
  availability String   @default("")
  bio          String   @default("")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profiles")
}

enum MentorshipStatus {
  pending
  accepted
  declined
  canceled
  completed
}

model MentorshipRequest {
  id        String           @id @default(uuid())
  teamId    String           @map("team_id")
  mentorId  String           @map("mentor_id")
  topic     String
  sessionNotes String? @map("session_notes")
  status    MentorshipStatus @default(pending)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mentor    User             @relation("MentorRequests", fields: [mentorId], references: [id], onDelete: Cascade)
  messages  MentorshipMessage[]
  slot      MentorSlot?

  @@index([mentorId, status, createdAt(sort: Desc)])
  @@index([teamId, createdAt(sort: Desc)])
  @@map("mentorship_requests")
}

model MentorshipMessage {
  id        String   @id @default(uuid())
  requestId String   @map("request_id")
  senderId  String   @map("sender_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  request   MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("mentorship_messages")
}

model MentorSlot {
  id        String   @id @default(uuid())
  mentorId  String   @map("mentor_id")
  teamId    String?  @map("team_id")
  requestId String?  @unique @map("request_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  mentor    User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  request   MentorshipRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([mentorId, startTime])
  @@map("mentor_slots")
}

enum ChallengeDifficulty {
  beginner
  intermediate
  advanced
}

model Challenge {
  id            String @id @default(uuid())
  slug          String @unique
  title         String
  titleAr       String? @map("title_ar")
  summary       String
  summaryAr     String? @map("summary_ar")
  description   String
  descriptionAr String? @map("description_ar")
  category      String
  difficulty    ChallengeDifficulty
  year          Int
  tags          String[] @default([])
  sourceUrl     String? @map("source_url")
  isPublished   Boolean @default(false) @map("is_published")
  isArchived    Boolean @default(false) @map("is_archived")
  isDemo        Boolean @default(false) @map("is_demo")
  version       Int @default(1)
  createdById   String @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     User @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  resources     ChallengeResource[]
  favorites     ChallengeFavorite[]
  teams         Team[]
  interestedProfiles Profile[] @relation("ProfilePreferredChallenge")
  requirementsEn String? @map("requirements_en")
  requirementsAr String? @map("requirements_ar")
  deliverablesEn String? @map("deliverables_en")
  deliverablesAr String? @map("deliverables_ar")
  subjects String[] @default([])
  recommendedSkills String[] @default([]) @map("recommended_skills")
  nasaChallengeId String? @map("nasa_challenge_id")
  displayOrder Int @default(0) @map("display_order")

  @@index([isPublished, isArchived, year(sort: Desc)])
  @@index([category, difficulty])
  @@map("challenges")
}

enum ResourceType {
  dataset
  api
  starter_code
  video
  tutorial
  document
  external_tool
}

enum ResourceLanguage {
  ar
  en
  both
}

model ChallengeResource {
  id          String @id @default(uuid())
  challengeId String @map("challenge_id")
  label       String
  url         String
  position    Int @default(0)
  titleAr String? @map("title_ar")
  descriptionEn String? @map("description_en")
  descriptionAr String? @map("description_ar")
  type ResourceType @default(dataset)
  language ResourceLanguage @default(en)
  isOfficial Boolean @default(false) @map("is_official")
  isCurated Boolean @default(true) @map("is_curated")
  isFeatured Boolean @default(false) @map("is_featured")
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, position])
  @@map("challenge_resources")
}

model ChallengeFavorite {
  userId      String @map("user_id")
  challengeId String @map("challenge_id")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([userId, challengeId])
  @@index([challengeId])
  @@map("challenge_favorites")
}

model JudgingRubric {
  id String @id @default(uuid())
  name String
  criteria Json
  createdAt DateTime @default(now())
  assignments JudgingAssignment[]
  @@map("judging_rubrics")
}

model JudgingAssignment {
  id String @id @default(uuid())
  judgeId String
  teamId String
  rubricId String
  submissionVersion Int
  snapshot Json
  scores Json @default("{}")
  feedback String @default("")
  completed Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  judge User @relation(fields: [judgeId], references: [id], onDelete: Restrict)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rubric JudgingRubric @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  @@unique([judgeId, teamId])
  @@index([judgeId, completed])
  @@map("judging_assignments")
}

model JudgingPublication {
  id String @id
  results Json
  publishedAt DateTime @default(now())
  @@map("judging_publications")
}

model RoleApplication {
  id String @id @default(uuid())
  userId String
  role String
  status String @default("pending")
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedById String?
  reason String @default("")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, role])
  @@index([status, createdAt])
  @@map("role_applications")
}


